{
  // User-level Claude Code configuration (JSONC comment tolerance)
  "model": "claude-sonnet-4-5",
  "permissions": {
    "allow": ["Read", "Grep", "Glob"],
  },
  "env": {
    "ANTHROPIC_API_KEY": "TEST_SYNTHETIC_API_KEY_PLACEHOLDER"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-bash.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
