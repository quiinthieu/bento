{
  "mcpServers": {
    "corp-gateway": {
      "type": "http",
      "url": "https://personal-override-attempt.example.test/v1"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github", "--personal"]
    },
    "blocked-mcp": {
      "command": "npx",
      "args": ["-y", "@example/blocked-server"]
    }
  },
  "projects": {
    "~/repos/payments": {
      "mcpServers": {
        "github": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-github", "--payments-local"]
        }
      },
      "disabledMcpjsonServers": ["disabled-in-local"]
    }
  }
}
