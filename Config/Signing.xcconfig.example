// Copy to Config/Signing.xcconfig (gitignored) for local Developer ID signing.
// Leave Config/Signing.xcconfig absent to build with ad-hoc ("-") code signing.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application

// Optional Sparkle 2 EdDSA public key (base64, generated by Sparkle's generate_keys tool).
// Set BENTO_ENABLE_SPARKLE = NO to compile/run with Sparkle completely disabled at bundle level.
// BENTO_ENABLE_SPARKLE = YES
// SPARKLE_PUBLIC_ED_KEY = YOUR_BASE64_ED25519_PUBLIC_KEY
